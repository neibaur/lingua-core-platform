{
  "name": "lingua-core-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Governance-first multi-tenant language platform engine.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "echo \"Error: Add framework runtime dev script later\" && exit 1",
    "build": "echo \"Error: Add framework runtime build script later\" && exit 1",
    "lint": "eslint .",
    "format": "prettier --write \".\"",
    "format:check": "prettier --check \".\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
  },
  "keywords": [
    "language-learning",
    "linguistics",
    "dictionary",
    "search-engine",
    "postgresql",
    "typescript",
    "seo",
    "modular-monolith",
    "fullstack",
    "nlp"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.7"
  }
}
