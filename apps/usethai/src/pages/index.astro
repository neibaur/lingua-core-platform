---
// UseThai.com — lookup page. The static shell (head, header, form) comes from
// the Layout and LookupForm components; the results are client-rendered by the
// script below, which fetches the SSR endpoint at /api/lookup (governed-core
// lexical lookup). No framework runtime — vanilla client TypeScript.
import Layout from "../layouts/Layout.astro";
import LookupForm from "../components/LookupForm.astro";
import {
  DEFAULT_DIRECTION,
  documentTitleForDirection,
  headingForDirection,
} from "../lib/direction-chrome";

// Seed the server-rendered chrome with the default direction so the <title> and
// <h1> are already direction-correct on first paint (matching the #dir select's
// initially-selected option); the client script below keeps them in sync as the
// direction changes — including in the neutral awaiting-input state.
const initialTitle = documentTitleForDirection(DEFAULT_DIRECTION);
const initialHeading = headingForDirection(DEFAULT_DIRECTION);
---

<Layout title={initialTitle} heading={initialHeading}>
  <LookupForm />

  <section id="results" aria-live="polite"></section>

  <script>
    import type {
      LexicalDefinition,
      LexicalEntry,
      LexicalLanguageDirection,
      LexicalLookupDiagnostic,
      LexicalLookupDiagnosticSeverity,
      LexicalLookupResult,
    } from "@core/lexical";
    // orderLexicalDiagnostics is the ONLY ordering applied to diagnostics — the
    // app introduces no ranking, scoring, or relevance ordering of its own.
    import { orderLexicalDiagnostics } from "@core/lexical";
    import {
      categoryForDiagnostic,
      messageForDiagnostic,
    } from "../lib/lookup-states";
    import {
      documentTitleForDirection,
      headingForDirection,
      normalizeDirection,
      placeholderForDirection,
    } from "../lib/direction-chrome";

    const form = document.getElementById("lookup-form");
    const qInput = document.getElementById("q") as HTMLInputElement | null;
    const dirSelect = document.getElementById("dir") as HTMLSelectElement | null;
    const results = document.getElementById("results");
    const heading = document.getElementById("page-heading");

    // Direction-aware page chrome (P2, Cluster 1 / F-0004). Reflect the active
    // lookup direction in the document <title> and the page <h1> at ALL times —
    // including the neutral awaiting-input state, before any lookup — driven
    // purely by the select's current value (which is app state), never by a
    // lookup result. No lookup is triggered here; only the chrome is updated.
    function syncDirectionChrome() {
      const direction = normalizeDirection(dirSelect.value);
      document.title = documentTitleForDirection(direction);
      heading.textContent = headingForDirection(direction);
      qInput.placeholder = placeholderForDirection(direction);
    }

    function escapeHtml(value: string): string {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    // A small severity tag, driven by the diagnostic's own severity value
    // (verified shape: "error" | "warning") rather than a per-code hardcode.
    function severityBadge(severity: LexicalLookupDiagnosticSeverity): string {
      const label = severity === "error" ? "error" : "warning";
      return `<span class="state__severity state__severity--${label}">${label}</span>`;
    }

    // Query/direction echo (P1-3). Rendered in EVERY result state. Sourced from
    // the client's own RAW controls — the verbatim query the user typed and the
    // human-readable direction label from the select — never from result.query
    // (which is the trimmed, core-seen value) or any core-processed/normalized
    // value. The raw query may be empty (awaiting-input); the direction label is
    // always shown.
    function renderEcho(rawQuery: string, dirLabel: string): string {
      const queryPart =
        rawQuery.trim() === ""
          ? ""
          : `<span class="echo__query">“${escapeHtml(rawQuery)}”</span>`;
      return (
        `<header class="echo">` +
        queryPart +
        `<span class="echo__dir">${escapeHtml(dirLabel)}</span>` +
        `</header>`
      );
    }

    // Each render fully replaces #results — no stale or overlapping fragments.
    // Every state is painted as the echo header followed by a state body, so the
    // query/direction echo is present uniformly.
    function paint(echo: string, body: string) {
      results.innerHTML = echo + body;
    }

    // Render a diagnostic list (P1-2). Diagnostics arrive already ordered via
    // orderLexicalDiagnostics; each is shown with its PRIMARY message (Policy B,
    // via messageForDiagnostic) and, as clearly-secondary text, core's verbatim
    // diagnostic.message. The verbatim secondary is displayed exactly as core
    // provides it — never edited, stripped, or reworded — and is suppressed only
    // when it is already the primary (an unmapped code under Policy B), to avoid
    // printing identical text twice. The raw code is never shown as primary text.
    function renderDiagnostics(
      diagnostics: readonly LexicalLookupDiagnostic[],
    ): string {
      return diagnostics
        .map((diagnostic: LexicalLookupDiagnostic) => {
          const primary = messageForDiagnostic(diagnostic);
          const verbatim = diagnostic.message;
          const secondary =
            verbatim === primary
              ? ""
              : `<p class="state__detail">${escapeHtml(verbatim)}</p>`;
          return (
            `<div class="state__diagnostic">` +
            `<p class="state__body">${escapeHtml(primary)}</p>` +
            secondary +
            `</div>`
          );
        })
        .join("");
    }

    // Success: the existing result-card hierarchy. Legibility only (P1-1) — each
    // entry's definitions render as an ordered list in core-returned array order
    // (no app-side sort), and multiple entries under one query are grouped with a
    // stable divider between cards.
    function renderResultBody(result: LexicalLookupResult): string {
      return (result.entries ?? [])
        .map((entry: LexicalEntry) => {
          const romanized = entry.romanized
            ? `<span class="romanized">${escapeHtml(entry.romanized)}</span>`
            : "";
          const defs =
            `<ol class="definitions">` +
            (entry.definitions ?? [])
              .map(
                (def: LexicalDefinition) =>
                  `<li class="definition">${escapeHtml(def.definition)} <span class="pos">(${escapeHtml(def.partOfSpeech)})</span></li>`,
              )
              .join("") +
            `</ol>`;
          return `<div class="entry"><p class="headword">${escapeHtml(entry.headword)} ${romanized}</p>${defs}</div>`;
        })
        .join(`<hr class="entry__divider" />`);
    }

    // Awaiting-input: a neutral resting state when there is nothing to look up
    // yet (empty or whitespace-only input). NOT an error and NOT a no-match —
    // no lookup is attempted, so the page makes no core call and shows no
    // diagnostic.
    function renderAwaitingInputBody(): string {
      return (
        `<div class="state state--awaiting">` +
        `<p class="state__body">Type a term above to look it up.</p>` +
        `</div>`
      );
    }

    // Loading: a neutral in-progress state while the request is in flight.
    function renderLoadingBody(): string {
      return '<div class="state state--loading"><span class="state__spinner" aria-hidden="true"></span><p class="state__body">Looking up…</p></div>';
    }

    // Purely presentational script-mismatch hint (F-0019, Cluster 12).
    // Returns a non-empty hint string only when the submitted query's script
    // obviously does not match the selected direction. Mixed or ambiguous
    // input returns “”. This check NEVER gates, skips, or precedes the core
    // call — it is only used to optionally append copy after core returns.
    function scriptMismatchHint(
      query: string,
      direction: LexicalLanguageDirection,
    ): string {
      const hasThai = /[฀-๿]/.test(query);
      const hasLatin = /[a-zA-Z]/.test(query);
      if (hasThai && hasLatin) return “”;
      if (direction === “th→en” && hasLatin && !hasThai) {
        return “This looks like an English term. Try switching the direction to English → Thai.”;
      }
      if (direction === “en→th” && hasThai && !hasLatin) {
        return “This looks like a Thai term. Try switching the direction to Thai → English.”;
      }
      return “”;
    }

    // No-result: a neutral “no exact match” — NOT an error. Explains exact-key
    // behavior. No suggestions, near-matches, or alternatives of any kind are
    // offered. When core supplied diagnostics they are rendered (primary +
    // verbatim secondary); otherwise the static exact-key explanation stands.
    // An optional hint string (from scriptMismatchHint) is appended when present.
    function renderNoResultBody(
      query: string,
      diagnostics: readonly LexicalLookupDiagnostic[],
      hint?: string,
    ): string {
      const detail =
        diagnostics.length > 0
          ? renderDiagnostics(diagnostics)
          : `<p class=”state__body”>This is an exact-key lookup, so only an entry whose key matches exactly is returned.</p>`;
      const hintHtml = hint
        ? `<p class=”state__hint”>${escapeHtml(hint)}</p>`
        : “”;
      return (
        `<div class=”state state--no-result”>` +
        `<p class=”state__heading”>No exact match for “${escapeHtml(query)}”.</p>` +
        detail +
        hintHtml +
        `</div>`
      );
    }

    // Rejected-input: the query was invalid input (whitespace-bearing), a
    // correctable condition distinct from a no-match and from a system error.
    // The heading badge follows the governing (first ordered) diagnostic's real
    // severity.
    function renderRejectedInputBody(
      diagnostics: readonly LexicalLookupDiagnostic[],
    ): string {
      const primary = diagnostics[0];
      return (
        `<div class="state state--rejected">` +
        `<p class="state__heading">Check your input ${severityBadge(primary.severity)}</p>` +
        renderDiagnostics(diagnostics) +
        `<p class="state__hint">Thai → English looks up one Thai token (e.g. กิน). ` +
        `English → Thai matches an English term by exact equality.</p>` +
        `</div>`
      );
    }

    // System condition driven by core diagnostics: an empty index, or any
    // unmapped/future diagnostic code. Distinct from a normal no-match. The
    // accent tone and heading badge follow the governing diagnostic's real
    // severity; each diagnostic renders with its primary + verbatim secondary.
    function renderSystemDiagnosticsBody(
      heading: string,
      diagnostics: readonly LexicalLookupDiagnostic[],
    ): string {
      const primary = diagnostics[0];
      return (
        `<div class="state state--system state--system-${primary.severity}">` +
        `<p class="state__heading">${escapeHtml(heading)} ${severityBadge(primary.severity)}</p>` +
        renderDiagnostics(diagnostics) +
        `</div>`
      );
    }

    // System condition with an app-authored message and no core diagnostic — a
    // transport/request failure the app itself observed (HTTP error, network
    // error). No verbatim core message exists to disclose here.
    function renderSystemMessageBody(
      heading: string,
      message: string,
      severity: LexicalLookupDiagnosticSeverity,
    ): string {
      return (
        `<div class="state state--system state--system-${severity}">` +
        `<p class="state__heading">${escapeHtml(heading)} ${severityBadge(severity)}</p>` +
        `<p class="state__body">${escapeHtml(message)}</p>` +
        `</div>`
      );
    }

    // Decide which state a successful (HTTP-OK) response resolves to. Diagnostics
    // are ordered only via orderLexicalDiagnostics; the first ordered diagnostic
    // selects the presentation lane (categoryForDiagnostic), and every diagnostic
    // is rendered within that lane.
    function renderResponse(
      result: LexicalLookupResult,
      echo: string,
      rawQuery: string,
      direction: LexicalLanguageDirection,
    ) {
      const entries = result.entries ?? [];
      if (entries.length > 0) {
        paint(echo, renderResultBody(result));
        return;
      }

      const diagnostics = orderLexicalDiagnostics(result.diagnostics ?? []);
      const primary = diagnostics[0];
      if (!primary) {
        // No entries and no diagnostic: the honest answer is still no result.
        paint(
          echo,
          renderNoResultBody(
            result.query,
            [],
            scriptMismatchHint(rawQuery, direction),
          ),
        );
        return;
      }

      const category = categoryForDiagnostic(primary);
      if (category === "rejected-input") {
        paint(echo, renderRejectedInputBody(diagnostics));
      } else if (category === "no-result") {
        paint(
          echo,
          renderNoResultBody(
            result.query,
            diagnostics,
            scriptMismatchHint(rawQuery, direction),
          ),
        );
      } else {
        paint(echo, renderSystemDiagnosticsBody("Lookup unavailable", diagnostics));
      }
    }

    async function doLookup(event?: Event) {
      if (event) event.preventDefault();
      const rawQuery = qInput.value;
      const dir = dirSelect.value;
      const dirLabel = dirSelect.options[dirSelect.selectedIndex]?.text ?? dir;
      const echo = renderEcho(rawQuery, dirLabel);
      // Empty or whitespace-only input is not a lookup: rest in the neutral
      // awaiting-input state without calling the endpoint. Whitespace-bearing
      // queries (e.g. "to eat") are NOT blocked here — they are sent intact so
      // core can resolve an en→th phrase or return its own th→en diagnostic.
      if (rawQuery.trim() === "") {
        paint(echo, renderAwaitingInputBody());
        return;
      }
      paint(echo, renderLoadingBody());
      try {
        const response = await fetch(
          `/api/lookup?q=${encodeURIComponent(rawQuery)}&dir=${encodeURIComponent(dir)}`,
        );
        if (!response.ok) {
          paint(
            echo,
            renderSystemMessageBody(
              "Lookup failed",
              `The lookup request failed (HTTP ${response.status}).`,
              "error",
            ),
          );
          return;
        }
        const result = (await response.json()) as LexicalLookupResult;
        renderResponse(result, echo, rawQuery, normalizeDirection(dir));
      } catch (error) {
        const detail = error instanceof Error ? error.message : String(error);
        paint(
          echo,
          renderSystemMessageBody(
            "Lookup failed",
            `The lookup request could not be completed: ${detail}`,
            "error",
          ),
        );
      }
    }

    form.addEventListener("submit", doLookup);
    // Keep the title/heading in sync when the direction changes, independently of
    // any lookup — the chrome must track direction even from the resting state.
    dirSelect.addEventListener("change", syncDirectionChrome);
    // Paint the direction chrome and run an initial lookup so both the chrome and
    // the acceptance word are correct on load.
    syncDirectionChrome();
    doLookup();
  </script>
</Layout>
