---
// UseThai.com — lookup page. The static shell (head, header, form) comes from
// the Layout and LookupForm components; the results are client-rendered by the
// script below, which fetches the SSR endpoint at /api/lookup (governed-core
// lexical lookup). No framework runtime — vanilla client TypeScript.
import Layout from "../layouts/Layout.astro";
import LookupForm from "../components/LookupForm.astro";
---

<Layout title="UseThai — lookup">
  <LookupForm />

  <section id="results" aria-live="polite"></section>

  <script>
    import type {
      LexicalDefinition,
      LexicalEntry,
      LexicalLookupResult,
    } from "@core/lexical";

    const form = document.getElementById("lookup-form");
    const qInput = document.getElementById("q") as HTMLInputElement | null;
    const dirSelect = document.getElementById("dir") as HTMLSelectElement | null;
    const results = document.getElementById("results");

    function escapeHtml(value: string): string {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    function renderEntries(result: LexicalLookupResult) {
      const entries = result.entries ?? [];
      const diagnostics = result.diagnostics ?? [];

      if (entries.length === 0) {
        const reason =
          diagnostics.length > 0
            ? escapeHtml(diagnostics[0].message)
            : "No entry found.";
        results.innerHTML = `<p class="diagnostic">${reason}</p>`;
        return;
      }

      results.innerHTML = entries
        .map((entry: LexicalEntry) => {
          const romanized = entry.romanized
            ? `<span class="romanized">${escapeHtml(entry.romanized)}</span>`
            : "";
          const defs = (entry.definitions ?? [])
            .map(
              (def: LexicalDefinition) =>
                `<p class="definition">${escapeHtml(def.definition)} <span class="pos">(${escapeHtml(def.partOfSpeech)})</span></p>`,
            )
            .join("");
          return `<div class="entry"><p class="headword">${escapeHtml(entry.headword)} ${romanized}</p>${defs}</div>`;
        })
        .join("");
    }

    async function doLookup(event?: Event) {
      event?.preventDefault();
      if (event) event.preventDefault();
      const q = qInput.value;
      const dir = dirSelect.value;
      results.innerHTML = '<p class="muted">Looking up…</p>';
      try {
        const response = await fetch(
          `/api/lookup?q=${encodeURIComponent(q)}&dir=${encodeURIComponent(dir)}`,
        );
        const result = await response.json();
        renderEntries(result);
      } catch (error) {
        results.innerHTML = `<p class="diagnostic">Lookup failed: ${escapeHtml(error)}</p>`;
      }
    }

    form.addEventListener("submit", doLookup);
    // Run an initial lookup so the acceptance word renders on load.
    doLookup();
  </script>
</Layout>
